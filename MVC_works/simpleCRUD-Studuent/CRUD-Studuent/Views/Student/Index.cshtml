@model List<CRUD_Studuent.Models.Student>

    <h2>Student List</h2>
    <a href="/Student/Create">Add New</a>

    <table border="1">
        <tr>
            <th>Name</th>
            <th>Age</th>
            <th>Actions</th>
        </tr>

        @foreach(var s in Model)
    {
        <tr>
    
            <td>@s.Name</td>
            <td>@s.Age</td>
            <td>
                <a href="/Student/Edit/@s.Id">EDIT</a>|
                <a href="/Student/Delete/@s.Id">DELETE</a>
            </td>
        </tr>
    }

    </table>